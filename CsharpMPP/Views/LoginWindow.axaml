<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CsharpMPP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
        x:Class="CsharpMPP.Views.LoginWindow"
        x:DataType="vm:LoginWindowViewModel" Width="300" Height="300">
    
        <Grid ColumnDefinitions="*" RowDefinitions="*, *, *, *" Margin="40">
                <TextBlock Text="Welcome" FontSize="24" HorizontalAlignment="Center" Margin="0, 0, 0, 10" FontWeight="Bold"></TextBlock>
                <TextBox Grid.Row="1" Text="{Binding Username}" Watermark="Username" CornerRadius="8" Height="40" BorderBrush="#DDDDDD" VerticalContentAlignment="Center"></TextBox>
                <TextBox Grid.Row="2" Text="{Binding Password}" PasswordChar="*" Watermark="Password" CornerRadius="8" Height="40" BorderBrush="#DDDDDD" VerticalContentAlignment="Center"></TextBox>
                <Button Grid.Row="3" Content="Login" Command="{Binding Login}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="45" CornerRadius="8" FontWeight="Bold"></Button>
        </Grid>
</UserControl>