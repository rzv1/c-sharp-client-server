<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaClient.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:AvaloniaClient.ViewModels"
        xmlns:views="clr-namespace:AvaloniaClient.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="AvaloniaClient.Views.Main"
        x:DataType="viewModels:MainViewModel">
        <Window.DataTemplates>
                <DataTemplate DataType="{x:Type vm:LoginWindowViewModel}">
                        <views:LoginWindow />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
                        <views:MainWindow />
                </DataTemplate>
        </Window.DataTemplates>

        <ContentControl Content="{Binding CurrentPage}" />
</Window>